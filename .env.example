# ============================================
# Wikipedia Telegram Bot Configuration
# ============================================

# --------------------------------------------
# ОБЯЗАТЕЛЬНЫЕ ПАРАМЕТРЫ
# --------------------------------------------

# Telegram Bot Token
# Получите токен у @BotFather в Telegram:
# 1. Откройте @BotFather
# 2. Отправьте команду /newbot
# 3. Следуйте инструкциям
# 4. Скопируйте полученный токен сюда
# Формат: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=your_bot_token_here

# --------------------------------------------
# ОПЦИОНАЛЬНЫЕ ПАРАМЕТРЫ
# --------------------------------------------

# Доступные языки для Wikipedia
# Укажите двухбуквенные коды языков через запятую (без пробелов)
# По умолчанию: en (если не указано)
# 
# Популярные языки:
# ru - Русский
# en - English
# de - Deutsch (Немецкий)
# fr - Français (Французский)
# es - Español (Испанский)
# it - Italiano (Итальянский)
# ja - 日本語 (Японский)
# zh - 中文 (Китайский)
# pt - Português (Португальский)
# ar - العربية (Арабский)
# 
# Полный список кодов: https://en.wikipedia.org/wiki/List_of_ISO_639-1_codes
AVAILABLE_LANGUAGES=ru,en,de,fr

# --------------------------------------------
# ПРИМЕРЫ КОНФИГУРАЦИЙ
# --------------------------------------------

# Только английский:
# AVAILABLE_LANGUAGES=en

# Русский и английский:
# AVAILABLE_LANGUAGES=ru,en

# Множество европейских языков:
# AVAILABLE_LANGUAGES=ru,en,de,fr,es,it,pt

# Азиатские языки:
# AVAILABLE_LANGUAGES=ja,zh,ko,th,vi

# Максимальное покрытие:
# AVAILABLE_LANGUAGES=ru,en,de,fr,es,it,ja,zh,pt,ar,ko,nl,pl,tr
